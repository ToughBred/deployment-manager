# .github/workflows/_deploy.yml
# Reusable deployment workflow.
# Builds the Docker image, pushes it to GHCR, retrieves the manifest digest,
# and publishes a GitHub Release with deployment-metadata.json as an asset.
#
# The VPS deployment agent polls this release and applies it automatically.
# GitHub Actions does NOT SSH into the VPS, run migrations, or restart containers.

name: Deploy

on:
  workflow_call:
    inputs:
      environment:
        required: true
        type: string
        description: "Target environment name (dev, production)"
      image_suffix:
        required: true
        type: string
        description: "Docker image tag suffix (dev, prod)"
    secrets:
      GHCR_TOKEN:
        required: true

env:
  REGISTRY: ghcr.io
  IMAGE_NAME: ${{ github.repository_owner }}/gymportal

jobs:
  deploy:
    name: Build & Publish Deployment Metadata
    runs-on: ubuntu-latest
    environment: ${{ inputs.environment }}

    outputs:
      manifest_digest: ${{ steps.push.outputs.digest }}
      image_tag: ${{ inputs.image_suffix }}-latest
      release_tag: ${{ steps.release_tag.outputs.tag }}

    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Log in to GHCR
        uses: docker/login-action@v3
        with:
          registry: ${{ env.REGISTRY }}
          username: ${{ github.actor }}
          password: ${{ secrets.GHCR_TOKEN }}

      - name: Set up Docker Buildx
        uses: docker/setup-buildx-action@v3

      - name: Generate release tag
        id: release_tag
        run: |
          TAG="${{ inputs.environment }}-$(date -u +%Y%m%d%H%M%S)-${GITHUB_SHA::7}"
          echo "tag=${TAG}" >> "$GITHUB_OUTPUT"

      - name: Build and push Docker image
        id: push
        uses: docker/build-push-action@v5
        with:
          context: .
          push: true
          platforms: linux/amd64
          tags: |
            ${{ env.REGISTRY }}/${{ env.IMAGE_NAME }}:${{ inputs.image_suffix }}-latest
            ${{ env.REGISTRY }}/${{ env.IMAGE_NAME }}:sha-${{ github.sha }}
          cache-from: type=gha
          cache-to: type=gha,mode=max

      # digest is sha256:... — the immutable identifier.
      # This is what the agent uses for drift detection, not the tag.
      - name: Generate deployment metadata
        id: metadata
        run: |
          cat > deployment-metadata.json << EOF
          {
            "environment": "${{ inputs.environment }}",
            "image": "${{ env.REGISTRY }}/${{ env.IMAGE_NAME }}:${{ inputs.image_suffix }}-latest",
            "image_tag": "${{ inputs.image_suffix }}-latest",
            "manifest_digest": "${{ steps.push.outputs.digest }}",
            "git_sha": "${{ github.sha }}",
            "created_at": "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
          }
          EOF
          cat deployment-metadata.json

      - name: Create GitHub Release with metadata
        uses: softprops/action-gh-release@v2
        with:
          tag_name: ${{ steps.release_tag.outputs.tag }}
          name: "${{ inputs.environment }} deployment — ${{ github.sha }}"
          body: |
            **Environment:** `${{ inputs.environment }}`
            **Commit:** `${{ github.sha }}`
            **Image digest:** `${{ steps.push.outputs.digest }}`
            **Triggered by:** @${{ github.actor }}
          files: deployment-metadata.json
          make_latest: false
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
